{
  "name": "rajal-realestate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "supportedArchitectures": {
      "os": ["linux", "current"],
      "cpu": ["x64", "arm64"]
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation payload migrate && NODE_OPTIONS=--no-deprecation next dev",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "build": "NODE_OPTIONS=--no-deprecation payload migrate && NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:db-schema": "NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "payload": "NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/plugin-cloud-storage": "^3.85.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "payload": "^3.85.1",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.101.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
